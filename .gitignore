# Universal AI Workspace .gitignore

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments & uv cache
.venv/
env/
venv/
cache/uv_cache/
cache/bin/
.pytest_cache/

# Ephemeral runtime directories
runtime/
/content/runtime/
outputs/
inputs/

# Model weights and archives (keep repo lightweight!)
models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.aria2
*.imatrix.dat

# Machine-specific state and registry cache
configs/registry.json
runtime_state.json

# Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Logs & temporary files
*.log
*.tmp*
.DS_Store
